rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // 0. GLOBAL SAFETY NET
    // ==========================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // 1. PRIMITIVE HELPERS
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Helper to check for Master Admin status
    // Master Admin is anyone who has a session linked to the 'saw_vlogs_2026' access code.
    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/sessions/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.accessCode == 'saw_vlogs_2026';
    }

    // ==========================================
    // 2. ENTITY VALIDATION HELPERS
    // ==========================================
    
    function isValidVBSUserControl(data) {
      return data.vbsId is string && data.vbsId.size() <= 64 &&
             data.dailyUsage is number && data.dailyUsage >= 0 &&
             (data.lastUsedDate is string || data.lastUsedDate == null) &&
             data.isUnlimited is bool &&
             data.isBlocked is bool &&
             (data.membershipStatus == 'standard' || data.membershipStatus == 'premium' || data.membershipStatus == null);
    }

    function isValidActivityLog(data) {
      return data.vbsId is string && data.vbsId.size() <= 64 &&
             data.type is string && data.type.size() <= 32 &&
             data.details is string && data.details.size() <= 1024 &&
             data.createdAt is timestamp;
    }

    function isValidSession(data) {
      return data.accessCode is string && data.accessCode.size() <= 64 &&
             data.createdAt is timestamp;
    }

    function isValidHistoryItem(data) {
      return data.userId is string && data.userId.size() <= 64 &&
             data.audioStorageUrl is string && data.audioStorageUrl.size() <= 1024 &&
             data.createdAt is timestamp;
    }

    // ==========================================
    // 3. COLLECTION RULES
    // ==========================================

    // SESSION SYNC: Critical for Auth & Rules
    match /sessions/{uid} {
      allow get: if isOwner(uid);
      allow write: if isOwner(uid) && isValidSession(incoming());
      allow list, delete: if isAdmin();
    }

    // USER CONTROLS: Access codes and usage limits
    match /user_controls/{vbsId} {
      // Allow get for anyone signed in (needed for login check)
      allow get: if isSignedIn() && isValidId(vbsId);
      
      // Admin only for management
      allow list: if isAdmin();
      
      // Allow creation of master codes IF they don't exist (Bootstrap phase)
      allow create: if (isAdmin() || vbsId == 'saw_vlogs_2026' || vbsId == 'SAW-ADMIN-2026') && isValidVBSUserControl(incoming());
      
      allow update: if (isAdmin() || (isSignedIn() && incoming().diff(existing()).affectedKeys().hasOnly(['dailyUsage', 'lastUsedDate', 'updatedAt', 'lastLoginAt']))) && isValidVBSUserControl(incoming());
      
      allow delete: if isAdmin();
    }

    // SETTINGS: Global configuration
    match /settings/{docId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow write: if isAdmin();
    }

    // GLOBAL RULES: Phonetic mappings
    match /globalRules/{ruleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // HISTORY: User voiceover records
    match /history/{historyId} {
      // Users can list their own history
      allow list: if isSignedIn() && (isAdmin() || resource.data.userId == get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.accessCode);
      allow get: if isSignedIn() && (isAdmin() || resource.data.userId == get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.accessCode);
      allow create: if isSignedIn() && isValidHistoryItem(incoming()) && (isAdmin() || incoming().userId == get(/databases/$(database)/documents/sessions/$(request.auth.uid)).data.accessCode);
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // SYSTEM CONFIG: High sensitivity config
    match /system_config/{docId} {
      allow read, write: if isAdmin();
    }

    // ACTIVITY LOGS: Audit trails
    match /activity_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidActivityLog(incoming());
    }
  }
}
