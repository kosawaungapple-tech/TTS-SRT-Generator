rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Who is calling? ------------------------------------------------------------------------
    // Users sign in through the server (/api/auth/login), which issues a Firebase token carrying
    //   vbsId  = the access code of the account
    //   admin  = true only for admin accounts
    // Anonymous visitors have neither, so they can read and write nothing below.
    function signedIn() { return request.auth != null; }
    function isMember() { return signedIn() && 'vbsId' in request.auth.token; }
    function me() { return request.auth.token.vbsId; }
    function isAdmin() { return isMember() && request.auth.token.get('admin', false) == true; }
    function isOwner(id) { return isMember() && me() == id; }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // ---- Accounts -------------------------------------------------------------------------------
    // Contains password (hash) and per-user keys: only the owner and the admin can read it.
    match /user_controls/{id} {
      allow read: if isAdmin() || isOwner(id);
      allow create: if isAdmin();
      // A user may only touch their own usage counters, and can only ever lower their credits, never raise them.
      allow update: if isAdmin() || (
        isOwner(id)
        && onlyChanges(['dailyUsage', 'lastUsedDate', 'lastLoginAt', 'dailyTasks', 'credits', 'updatedAt'])
        && request.resource.data.get('credits', 0) <= resource.data.get('credits', 0)
      );
      allow delete: if isAdmin() || isOwner(id);   // account deletion from inside the app
    }

    match /sessions/{id} {
      allow read, write: if isAdmin() || (signedIn() && (request.auth.uid == id || isOwner(id)));
    }

    match /users/{id} {                      // legacy collection
      allow read, write: if isAdmin();
      allow delete: if isOwner(id);
    }

    // ---- Admin-only data ------------------------------------------------------------------------
    match /admin_channels/{id} { allow read, write: if isAdmin(); }      // the admin's Gemini API keys
    match /system_config/{doc} { allow read, write: if isAdmin(); }
    match /vlogs_users/{code} { allow read, write: if isAdmin(); }
    match /adminKeyStats/{id} {
      allow read: if isAdmin();
      allow create, update: if isMember();   // usage counters
    }

    // ---- Shared settings: members read, only the admin writes -----------------------------------
    match /settings/{doc} {
      allow read: if isMember();
      allow write: if isAdmin();
      allow update: if isMember() && doc == 'global' && onlyChanges(['total_generations']);
    }
    match /globalRules/{id} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // ---- A user's own records -------------------------------------------------------------------
    match /history/{id} {
      allow read: if isAdmin() || (isMember() && resource.data.userId == me());
      allow create: if isMember() && request.resource.data.userId == me();
      allow update, delete: if isAdmin() || (isMember() && resource.data.userId == me());
    }
    match /activity_logs/{id} {
      allow read: if isAdmin();
      allow create: if isMember() && request.resource.data.vbsId == me();
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
