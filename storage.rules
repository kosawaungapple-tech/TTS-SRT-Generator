rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isMember() { return request.auth != null && 'vbsId' in request.auth.token; }
    function isAdmin() { return isMember() && request.auth.token.get('admin', false) == true; }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // A user's own generated audio and subtitles (the folder name is the account's access code)
    match /audio/{vbsId}/{allPaths=**} {
      allow read, write: if isAdmin() || (isMember() && request.auth.token.vbsId == vbsId);
    }
    match /srt/{vbsId}/{allPaths=**} {
      allow read, write: if isAdmin() || (isMember() && request.auth.token.vbsId == vbsId);
    }
    match /history/{vbsId}/{allPaths=**} {
      allow read, write: if isAdmin() || (isMember() && request.auth.token.vbsId == vbsId);
    }
  }
}
